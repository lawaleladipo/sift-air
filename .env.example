# SIFT-AIR — Zero-Retention DFIR, Threat Hunting & Multi-Platform Detection-as-Code Workbench
PORT=8080
SIFT_LOCAL_TIMEZONE=UTC

# Zero-Retention Gemini / Vertex AI Configuration (store: false enforced on every call)
# Leave unset to run SIFT-AIR in 100% offline deterministic mode.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1

# Optional Read-Only SIEM / SASE Connectors (never granted write permissions)
CHRONICLE_CUSTOMER_UUID=YOUR_CHRONICLE_CUSTOMER_UUID
CHRONICLE_REGION=us
SASE_TENANT_URL=https://your-tenant.goskope.com
SASE_API_TOKEN=

# GitOps Detection-as-Code Defaults (used for human-gated MR runbook generation only)
DAC_GIT_REPO_URL=https://gitlab.com/your-org/secops-dac.git
DAC_ALERT_CHANNEL=#secops-dac-alerts
PROTECTED_CORP_DOMAINS=example-corp.com,acme-fintech.example
